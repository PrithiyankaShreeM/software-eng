<% if (flashMessages && flashMessages.length) { %>
  <% const iconMap = { success: 'check-circle', error: 'alert', danger: 'alert', warning: 'alert-triangle', info: 'info' }; %>
  <% flashMessages.forEach((flash) => { %>
    <div class="alert alert--<%= ['success','error','warning','info'].includes(flash.type) ? flash.type : 'info' %>" role="<%= flash.type === 'error' ? 'alert' : 'status' %>">
      <%- icon(iconMap[flash.type] || 'info') %>
      <div class="alert__body"><%= flash.message %></div>
      <button type="button" class="alert__close" data-dismiss aria-label="Dismiss message"><%- icon('x') %></button>
    </div>
  <% }); %>
<% } %>
