<div class="auth-shell auth-shell--single">
  <div class="auth-main" style="min-height:100vh;grid-column:1/-1">
    <div class="auth-main__bar">
      <%- include('../partials/brand', { variant: 'dark', nameOverride: university.shortName + ' Portal' }) %>
      <a href="/login" class="btn btn--ghost btn--sm"><%- icon('arrowLeft') %> Back to sign in</a>
    </div>

    <div class="auth-main__inner">
      <%- include('../partials/flash') %>

      <div class="form-head">
        <h1>Reset your password</h1>
        <p>Enter the User ID, Staff ID or email address registered with the university. We will issue a single-use reset link.</p>
      </div>

      <% if (typeof resetLink !== 'undefined' && resetLink) { %>
        <div class="alert alert--info" role="status">
          <%- icon('key') %>
          <div class="alert__body">
            <div class="alert__title">Demonstration reset link</div>
            <p class="mb-2">No email server is connected in this demonstration environment, so the single-use link is shown here. In production it would be delivered by email and never displayed on screen.</p>
            <a class="btn btn--primary btn--sm" href="<%= resetLink %>">Open reset form <%- icon('arrowRight') %></a>
            <div class="tiny mono mt-3" style="word-break:break-all;color:var(--ink-500)"><%= resetLink %></div>
          </div>
        </div>
      <% } %>

      <% if (typeof submitted !== 'undefined' && submitted) { %>
        <div class="security-note mb-4">
          <%- icon('shield-check') %>
          <span>For security, this page gives the same response whether or not the account exists — it cannot be used to discover valid User IDs.</span>
        </div>
      <% } %>

      <form method="post" action="/forgot-password" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label class="field__label" for="identifier"><span>User ID, Staff ID or email address</span></label>
          <div class="input-wrap input-wrap--icon">
            <%- icon('user', { className: 'input-wrap__icon' }) %>
            <input class="input input--mono" type="text" id="identifier" name="identifier" required
                   autocomplete="username" autocapitalize="none" spellcheck="false"
                   placeholder="e.g. STU2024001 or you@msu.example.edu"
                   aria-describedby="reset-hint"
                   <%= errors && errors.identifier ? 'aria-invalid="true"' : '' %>>
          </div>
          <div class="field__hint" id="reset-hint">Reset links expire after 30 minutes and may be used once.</div>
          <% if (errors && errors.identifier) { %>
            <div class="field__error"><%- icon('alert') %><%= errors.identifier %></div>
          <% } %>
        </div>
        <button type="submit" class="btn btn--primary btn--lg btn--block" data-submit-btn>
          <span class="btn__spinner" aria-hidden="true"></span>
          <span class="btn__label"><%- icon('send') %> Send reset link</span>
        </button>
      </form>

      <div class="security-note mt-5">
        <%- icon('info') %>
        <span>If you no longer have access to your registered email, contact the examination office at <%= university.supportEmail %> or call <%= university.helpline %>.</span>
      </div>
    </div>
  </div>
</div>
