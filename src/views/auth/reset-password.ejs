<div class="auth-shell auth-shell--single">
  <div class="auth-main" style="min-height:100vh;grid-column:1/-1">
    <div class="auth-main__bar">
      <%- include('../partials/brand', { variant: 'dark', nameOverride: university.shortName + ' Portal' }) %>
      <a href="/login" class="btn btn--ghost btn--sm"><%- icon('arrowLeft') %> Back to sign in</a>
    </div>

    <div class="auth-main__inner">
      <%- include('../partials/flash') %>

      <div class="form-head">
        <h1>Choose a new password</h1>
        <p>
          <% if (resetRecord) { %>
            Resetting the password for <strong><%= resetRecord.full_name %></strong> (<span class="mono"><%= resetRecord.username %></span>).
          <% } else { %>
            This reset link is no longer valid.
          <% } %>
        </p>
      </div>

      <% if (!resetRecord) { %>
        <div class="alert alert--error" role="alert">
          <%- icon('alert') %>
          <div class="alert__body">
            <div class="alert__title">Invalid or expired link</div>
            <%= typeof resetError !== 'undefined' && resetError ? resetError : 'Request a new password reset link to continue.' %>
          </div>
        </div>
        <a href="/forgot-password" class="btn btn--primary btn--block btn--lg"><%- icon('refresh') %> Request a new link</a>
      <% } else { %>
        <% if (errors && errors.length) { %>
          <div class="alert alert--error" role="alert">
            <%- icon('alert') %>
            <div class="alert__body">
              <div class="alert__title">Please correct the following</div>
              <ul style="margin:4px 0 0;padding-left:18px">
                <% errors.forEach((e) => { %><li><%= e %></li><% }); %>
              </ul>
            </div>
          </div>
        <% } %>

        <form method="post" action="/reset-password/<%= token %>" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field">
            <label class="field__label" for="password"><span>New password</span></label>
            <div class="input-wrap input-wrap--icon input-wrap--action">
              <%- icon('lock', { className: 'input-wrap__icon' }) %>
              <input class="input" type="password" id="password" name="password" required
                     autocomplete="new-password" minlength="10" data-pw-strength>
              <button type="button" class="pw-toggle" data-password-toggle="password"
                      aria-label="Show password" aria-pressed="false">
                <span data-eye-show><%- icon('eye') %></span>
                <span data-eye-hide hidden><%- icon('eye-off') %></span>
              </button>
            </div>
            <div class="pw-meter" data-pw-meter data-score="0" hidden>
              <div class="pw-meter__bars"><span class="pw-meter__bar"></span><span class="pw-meter__bar"></span><span class="pw-meter__bar"></span><span class="pw-meter__bar"></span></div>
              <div class="pw-meter__label" data-pw-label>Enter a password</div>
            </div>
            <div class="field__hint">At least 10 characters, with upper-case, lower-case and a number.</div>
          </div>

          <div class="field">
            <label class="field__label" for="confirm_password"><span>Confirm new password</span></label>
            <div class="input-wrap input-wrap--icon input-wrap--action">
              <%- icon('lock', { className: 'input-wrap__icon' }) %>
              <input class="input" type="password" id="confirm_password" name="confirm_password" required
                     autocomplete="new-password" data-pw-confirm="password">
              <button type="button" class="pw-toggle" data-password-toggle="confirm_password"
                      aria-label="Show password" aria-pressed="false">
                <span data-eye-show><%- icon('eye') %></span>
                <span data-eye-hide hidden><%- icon('eye-off') %></span>
              </button>
            </div>
            <div class="field__error" data-pw-match hidden><%- icon('alert') %> Passwords do not match</div>
          </div>

          <div class="security-note mb-4">
            <%- icon('shield-check') %>
            <span>For your protection, all active sessions for this account will be signed out once the password is changed.</span>
          </div>

          <button type="submit" class="btn btn--primary btn--lg btn--block" data-submit-btn>
            <span class="btn__spinner" aria-hidden="true"></span>
            <span class="btn__label"><%- icon('check') %> Update password</span>
          </button>
        </form>
      <% } %>
    </div>
  </div>
</div>
