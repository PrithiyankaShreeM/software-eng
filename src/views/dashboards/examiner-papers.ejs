<div class="page-head">
  <div class="page-head__text">
    <h2>Question Papers &amp; Rubrics</h2>
    <p>Author papers, record the marking rubric and submit for moderation</p>
  </div>
  <div class="page-head__actions">
    <button type="button" class="btn btn--primary btn--sm" data-modal-open="newPaper"><%- icon('plus') %> New question paper</button>
  </div>
</div>

<div class="security-note mb-4">
  <%- icon('shield-check') %>
  <span>A rubric is mandatory. Moderators compare every evaluation against the rubric you record here — papers without a rubric cannot be submitted.</span>
</div>

<section class="card">
  <div class="card__head">
    <div><h3>My Question Papers</h3><p><%= papers.length %> paper<%= papers.length === 1 ? '' : 's' %> on record</p></div>
  </div>
  <% if (papers.length === 0) { %>
    <div class="empty"><div class="empty__icon"><%- icon('file') %></div><h4>No question papers yet</h4><p>Create your first paper using the button above.</p></div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th scope="col">Paper</th><th scope="col">Examination</th><th scope="col">Rubric</th><th scope="col" class="text-right">Total</th><th scope="col">Status</th><th scope="col" class="text-right">Action</th></tr>
        </thead>
        <tbody>
          <% papers.forEach((p) => { %>
            <tr>
              <td><div class="table__primary"><%= p.title %></div><div class="table__sub">Updated <%= timeAgo(p.updated_at) %></div></td>
              <td><div class="table__primary"><%= p.code %></div><div class="table__sub"><%= p.exam_title %></div></td>
              <td class="tiny muted" style="max-width:280px"><%= p.rubric || '—' %></td>
              <td class="text-right table__num"><%= p.total_marks %></td>
              <td><span class="badge badge--<%= p.status === 'approved' ? 'success' : p.status === 'submitted' ? 'info' : 'neutral' %>"><%= p.status %></span></td>
              <td class="text-right">
                <% if (p.status === 'draft') { %>
                  <form method="post" action="/examiner/papers/<%= p.id %>/submit" style="display:inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn--ghost btn--sm"><%- icon('send') %> Submit</button>
                  </form>
                <% } else { %>
                  <span class="tiny muted">Locked</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<div class="modal-overlay" id="newPaper" role="dialog" aria-modal="true" aria-labelledby="newPaperTitle">
  <div class="modal modal--wide">
    <form method="post" action="/examiner/papers">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal__head">
        <div><h3 id="newPaperTitle">Create a question paper</h3><p>Papers are saved as drafts and can be submitted for moderation.</p></div>
        <button type="button" class="modal__close" data-modal-close aria-label="Close"><%- icon('x') %></button>
      </div>
      <div class="modal__body">
        <div class="field">
          <label class="field__label" for="exam_id">Examination</label>
          <select class="input" id="exam_id" name="exam_id" required>
            <option value="">Choose an examination…</option>
            <% exams.forEach((e) => { %><option value="<%= e.id %>"><%= e.code %> — <%= e.title %> (<%= formatDate(e.exam_date) %>)</option><% }); %>
          </select>
        </div>
        <div class="field">
          <label class="field__label" for="title">Paper title</label>
          <input class="input" id="title" name="title" placeholder="End Semester Paper — Set A" required>
        </div>
        <div class="field">
          <label class="field__label" for="total_marks">Total marks</label>
          <input class="input" id="total_marks" name="total_marks" type="number" value="100" min="1" max="200" required>
        </div>
        <div class="field">
          <label class="field__label" for="rubric">Marking rubric</label>
          <textarea class="input" id="rubric" name="rubric" required placeholder="e.g. Part A: 10 × 2 marks · Part B: 5 × 6 marks · Part C: 2 × 20 marks"></textarea>
          <div class="field__hint">Moderators use this rubric to verify every evaluation.</div>
        </div>
      </div>
      <div class="modal__foot">
        <button type="button" class="btn btn--ghost" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn--primary" data-submit-btn>
          <span class="btn__spinner" aria-hidden="true"></span>
          <span class="btn__label"><%- icon('file') %> Save draft</span>
        </button>
      </div>
    </form>
  </div>
</div>
