<div class="page-head">
  <div class="page-head__text">
    <h2>Evaluation Queue</h2>
    <p>Mark answer scripts against the approved rubric</p>
  </div>
</div>

<div class="grid-3 mb-4">
  <div class="stat stat--warning">
    <div class="stat__top"><span class="stat__label">Awaiting evaluation</span><span class="stat__icon"><%- icon('clipboard') %></span></div>
    <div class="stat__value"><%= stats.awaitingEvaluation %></div>
  </div>
  <div class="stat stat--success">
    <div class="stat__top"><span class="stat__label">Evaluated</span><span class="stat__icon"><%- icon('check-circle') %></span></div>
    <div class="stat__value"><%= stats.evaluated %></div>
  </div>
  <div class="stat stat--gold">
    <div class="stat__top"><span class="stat__label">Flagged for moderation</span><span class="stat__icon"><%- icon('flag') %></span></div>
    <div class="stat__value"><%= queue.filter((q) => q.status === 'flagged').length %></div>
  </div>
</div>

<div class="security-note mb-4">
  <%- icon('shield') %>
  <span>Once a script enters moderation or is approved by the Controller, its marks are <strong>locked</strong> and cannot be overwritten by an examiner.</span>
</div>

<section class="card">
  <div class="card__head">
    <div><h3>Scripts</h3><p><%= queue.length %> records in your queue</p></div>
  </div>
  <% if (queue.length === 0) { %>
    <div class="empty"><div class="empty__icon"><%- icon('clipboard') %></div><h4>No scripts to evaluate</h4><p>Scripts appear here once examinations are completed and registrations are finalised.</p></div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th scope="col">Student</th><th scope="col">Paper</th><th scope="col" class="text-right">Marks</th><th scope="col">Status</th><th scope="col" class="text-right">Action</th></tr>
        </thead>
        <tbody>
          <% queue.forEach((q) => { const locked = ['moderated','approved'].includes(q.status); %>
            <tr>
              <td><div class="table__primary"><%= q.student_name %></div><div class="table__sub mono"><%= q.student_public_id %></div></td>
              <td><div class="table__primary"><%= q.code %></div><div class="table__sub"><%= q.exam_title %></div></td>
              <td class="text-right table__num"><%= q.marks_awarded !== null ? q.marks_awarded : '—' %> <span class="muted tiny">/ <%= q.max_marks %></span></td>
              <td>
                <span class="badge badge--<%= q.status === 'flagged' ? 'warning' : q.status === 'evaluated' ? 'success' : q.status === 'pending' ? 'neutral' : 'info' %>"><%= q.status %></span>
              </td>
              <td class="text-right">
                <% if (locked) { %>
                  <span class="tiny muted"><%- icon('lock', { size: 11 }) %> Locked</span>
                <% } else { %>
                  <button type="button" class="btn btn--ghost btn--sm" data-modal-open="evalModal"
                          data-modal-prefill='<%= JSON.stringify({ evaluation_id: q.id, marks: q.marks_awarded !== null ? q.marks_awarded : "", student: q.student_name, paper: q.code + " — " + q.exam_title }) %>'>
                    <%- icon('pencil') %> Evaluate
                  </button>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<div class="modal-overlay" id="evalModal" role="dialog" aria-modal="true" aria-labelledby="evalTitle">
  <div class="modal">
    <form method="post" action="/examiner/evaluations" id="evalForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal__head">
        <div><h3 id="evalTitle">Record evaluation</h3><p>Enter the marks awarded and any remarks for the moderator.</p></div>
        <button type="button" class="modal__close" data-modal-close aria-label="Close"><%- icon('x') %></button>
      </div>
      <div class="modal__body">
        <div class="portal-note" style="margin-bottom:var(--sp-4)">
          <%- icon('user') %>
          <span><strong data-eval-student>—</strong> · <span data-eval-paper>—</span></span>
        </div>
        <div class="field">
          <label class="field__label" for="marks">Marks awarded (out of 100)</label>
          <input class="input" id="marks" name="marks" type="number" min="0" max="100" step="0.5" required>
        </div>
        <div class="field">
          <label class="field__label" for="remarks">Remarks</label>
          <textarea class="input" id="remarks" name="remarks" placeholder="Notes for the moderator, e.g. partial credit awarded for question 7(c)."></textarea>
        </div>
      </div>
      <div class="modal__foot">
        <button type="button" class="btn btn--ghost" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn--primary" data-submit-btn>
          <span class="btn__spinner" aria-hidden="true"></span>
          <span class="btn__label"><%- icon('check') %> Save evaluation</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // Route the shared evaluation modal to the correct evaluation id and
  // mirror the student/paper labels into the dialog.
  document.addEventListener('click', function (event) {
    const trigger = event.target.closest('[data-modal-open="evalModal"]');
    if (!trigger) return;
    let data = {};
    try { data = JSON.parse(trigger.getAttribute('data-modal-prefill') || '{}'); } catch (e) { data = {}; }
    const form = document.getElementById('evalForm');
    if (form && data.evaluation_id) {
      form.setAttribute('action', '/examiner/evaluations/' + data.evaluation_id);
    }
    const student = document.querySelector('[data-eval-student]');
    const paper = document.querySelector('[data-eval-paper]');
    if (student) student.textContent = data.student || '—';
    if (paper) paper.textContent = data.paper || '—';
    const marks = document.getElementById('marks');
    if (marks && data.marks !== undefined && data.marks !== null && data.marks !== '') marks.value = data.marks;
  });
</script>
