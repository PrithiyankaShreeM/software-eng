<%
  const gradeClass = (g) => g === 'O' ? 'o' : g === 'A+' ? 'aplus' : g === 'A' ? 'a' : g === 'B+' ? 'bplus' : g === 'B' ? 'b' : g === 'C' ? 'c' : 'f';
  const semesters = Object.keys(records.bySemester).sort((a, b) => Number(a) - Number(b));
%>

<div class="page-head">
  <div class="page-head__text">
    <h2>Academic Records</h2>
    <p>Consolidated academic history, semester-wise performance and issued credentials</p>
  </div>
  <div class="page-head__actions">
    <button type="button" class="btn btn--ghost btn--sm" onclick="window.print()"><%- icon('print') %> Print record</button>
  </div>
</div>

<div class="role-banner">
  <div class="role-banner__icon"><%- icon('user') %></div>
  <div class="role-banner__body">
    <div class="role-banner__title"><%= currentUser.fullName %></div>
    <div class="role-banner__desc">
      <%= currentUser.publicId %> · <%= currentUser.programme || 'Programme not set' %> · <%= currentUser.department || 'Department not set' %>
    </div>
  </div>
  <div class="role-banner__meta">
    <span class="badge badge--gold">GPA <%= records.gpa || '—' %></span>
    <span class="badge badge--success"><%= records.results.length %> papers</span>
  </div>
</div>

<% if (records.results.length === 0) { %>
  <div class="card">
    <div class="empty">
      <div class="empty__icon"><%- icon('folder') %></div>
      <h4>No academic record yet</h4>
      <p>Your academic record is built from published results. Once the Controller publishes your first result set, your transcript will appear here.</p>
    </div>
  </div>
<% } else { %>
  <div class="stack">
    <% semesters.forEach((sem) => { const rows = records.bySemester[sem]; const semAvg = Math.round(rows.reduce((s, r) => s + r.marks, 0) / rows.length); %>
      <section class="card">
        <div class="card__head">
          <div>
            <h3>Semester <%= sem %></h3>
            <p><%= rows.length %> paper<%= rows.length === 1 ? '' : 's' %> · average <%= semAvg %>/100</p>
          </div>
          <div class="card__actions">
            <span class="badge badge--<%= semAvg >= 75 ? 'success' : semAvg >= 50 ? 'info' : 'warning' %>">Average <%= semAvg %></span>
          </div>
        </div>
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th scope="col">Code</th>
                <th scope="col">Paper</th>
                <th scope="col" class="text-right">Marks</th>
                <th scope="col" class="text-center">Grade</th>
                <th scope="col" class="text-center">Credits</th>
                <th scope="col" class="text-right">Published</th>
              </tr>
            </thead>
            <tbody>
              <% rows.forEach((r) => { %>
                <tr>
                  <td class="mono strong"><%= r.code %></td>
                  <td class="table__primary"><%= r.title %></td>
                  <td class="text-right table__num"><%= r.marks %> <span class="muted tiny">/ <%= r.max_marks %></span></td>
                  <td class="text-center"><span class="grade grade--<%= gradeClass(r.grade) %>"><%= r.grade %></span></td>
                  <td class="text-center tiny muted"><%= r.marks >= 40 ? '4' : '0' %></td>
                  <td class="text-right tiny muted nowrap"><%= formatDate(r.published_at) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </section>
    <% }); %>

    <!-- Credentials -->
    <section class="card">
      <div class="card__head">
        <div><h3>Issued Credentials</h3><p>Degree certificates recorded in the university credential registry</p></div>
      </div>
      <% if (records.credentials.length === 0) { %>
        <div class="empty" style="padding:var(--sp-8) var(--sp-5)">
          <div class="empty__icon"><%- icon('certificate') %></div>
          <h4>No credentials issued</h4>
          <p>Degree certificates appear here once conferred and registered by the university.</p>
        </div>
      <% } else { %>
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th scope="col">Credential No.</th>
                <th scope="col">Degree</th>
                <th scope="col">Classification</th>
                <th scope="col">Issued on</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <tbody>
              <% records.credentials.forEach((c) => { %>
                <tr>
                  <td class="mono strong"><%= c.credential_no %></td>
                  <td>
                    <div class="table__primary"><%= c.degree %></div>
                    <div class="table__sub"><%= c.department %></div>
                  </td>
                  <td class="tiny"><%= c.class_awarded %></td>
                  <td class="tiny muted nowrap"><%= formatDate(c.issued_on) %></td>
                  <td>
                    <span class="badge badge--<%= c.status === 'issued' ? 'success' : 'danger' %>"><%= c.status === 'issued' ? 'Valid' : 'Revoked' %></span>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <div class="card__foot">
          External agencies can verify these credentials through the university verification portal using the credential number.
        </div>
      <% } %>
    </section>
  </div>
<% } %>
