# ---------------------------------------------------------------
# UniExam — Centralized Authentication & Role-Based Access
# Copy to .env and adjust for your environment.
# ---------------------------------------------------------------

# HTTP port (the app binds to 0.0.0.0)
PORT=3000

# development | production
NODE_ENV=development

# Secret used to sign session + CSRF cookies.
# REQUIRED in production. Generate with: openssl rand -hex 32
COOKIE_SECRET=change-me-in-production-please-use-32-bytes

# Set to "true" when served over HTTPS so cookies get the Secure flag.
COOKIE_SECURE=false

# Absolute path to the SQLite database file (optional)
# DB_PATH=./data/uniexam.db

# Session lifetimes (minutes)
SESSION_IDLE_MINUTES=120
SESSION_REMEMBER_DAYS=30

# Brute-force protection
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
